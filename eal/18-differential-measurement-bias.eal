language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_18 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Monte Carlo bias stress test and constructed task-level example",
        "details": "In these simulated trials, the true labour saving is exactly one person-hour per initial requirement unit and the retained fraction falls by exactly five percentage points. A benefit requires a greater saving and a smaller loss. Measurement errors favour the AI group by overstating its saving by one hour per unit and its retained fraction by six percentage points. The analysis allows for 0.2 hours per unit and one percentage point respectively. The rule falsely declares a benefit in 9,561 of 20,000 trials with 48 teams and in 15,242 of 20,000 with 96 teams."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Monte Carlo bias stress test and constructed task-level example",
        "details": "The simulation draws standard normal values for labour and retention with correlation 0.3 within a team and 0.7 within a pair for the same outcome. A labour value z gives baseline hours per initial unit of 3 + 7 exp(0.35 z − 0.35²/2). For retention the corresponding formula is 0.72 + 0.25/(1 + exp(−1.4 z)). Each pair provides both outcomes. The paired differences include independent normal measurement errors with standard deviations of sqrt(2) times 0.2 hours per initial unit for labour and sqrt(2) times 0.005 for retention. A separate worked example traces the bias to individual tasks. Each of twelve teams has two fixed requirements. Accurate measurements put both mean effects exactly at their thresholds, so the rule withholds a benefit declaration. Omitting one reviewer-hour per initial unit from the AI teams’ hours raises their apparent saving to two hours per unit. Counting six unfulfilled criteria per hundred as satisfied turns the five-point loss into an apparent one-point gain. Those two measurement errors produce a benefit declaration for the same work."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The false-declaration rates of 47.81% and 76.21% apply to the specified biases and simulated teams. Measuring how often comparable errors occur in a workplace, and how large they are, requires an independent estimate of omitted time and wrongly scored requirements."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The false-declaration rates of 47.81% and 76.21% apply to the specified biases and simulated teams. Measuring how often comparable errors occur in a workplace, and how large they are, requires an independent estimate of omitted time and wrongly scored requirements."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "When measurement errors consistently favour one group, more independent pairs can reduce the sampling uncertainty around a biased mean difference. The adjusted bounds can then cross the decision thresholds more often even though the underlying effects remain at those thresholds."
    backing [backing_material]
  }

  claim finding {
    statement "A larger trial can declare a benefit falsely more often when systematic measurement errors favour AI by more than the analysis allows."
    environment engineering_work
  }

  claim exception_applies {
    statement "Applying this result to a particular workforce requires evidence that differences in measurement bias between the two groups could exceed the allowances."
    environment engineering_work
  }

  // Time reviews independently and test whether the software satisfies the follow-up
  // criteria. These checks can bound the difference in measurement bias between groups.
  // If plausible corrections take either outcome across its threshold, collecting more
  // teams’ reports alone cannot settle the decision.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}
