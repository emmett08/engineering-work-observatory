language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_11 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Two-phase design argument and implementation scope",
        "details": "Draw eligible intervals with known positive inclusion probabilities. Among sampled intervals with no reply, draw a follow-up sample with known positive conditional probabilities. Measure the original interval accurately in each selected follow-up."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Two-phase design argument and implementation scope",
        "details": "When an omitted interval is followed up with probability one half, its selected contribution equals twice its initial weighted residual. Averaging that contribution with zero when omitted recovers its initial weighted residual. Performing this calculation for all omissions and averaging over the first draw recovers the total."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Initial response may depend on workload. The result requires accurate supplied allocations, a frame covering the work and known positive probabilities for both draws."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Initial response may depend on workload. The result requires accurate supplied allocations, a frame covering the work and known positive probabilities for both draws."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Weight first replies by inverse initial inclusion probability, and follow-up replies by the inverse product of initial and conditional follow-up inclusion probabilities. The conditional expectation of the weighted follow-ups recovers the weighted residual total for the original omissions."
    backing [backing_material]
  }

  claim finding {
    statement "Random follow-up with known probabilities can correct initial non-response when follow-up measurements are accurate. Remaining unknown hours can be bounded."
    environment engineering_work
  }

  claim exception_applies {
    statement "The follow-up design leaves some eligible missing intervals with zero selection chance or fails to obtain accurate hours from selected follow-ups."
    environment engineering_work
  }

  // If a selected follow-up still leaves hours unknown, use zero and full eligible
  // duration to bound the estimate for the observed draws. Inference for the underlying
  // total must also account for variation across both draws.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}
