language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_17 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Monte Carlo design evaluation and one-parameter sensitivity analyses",
        "details": "In the central scenario AI saves two person-hours per initial requirement unit and leaves the retained fraction unchanged by construction. Benefit requires evidence of a saving greater than one hour per unit and a retention loss smaller than five percentage points. Of 20,000 simulated trials at each size, 8,957 passed with 48 teams and 15,450 passed with 96 teams. In the larger design, 4,541 of the 4,550 failures missed the labour threshold."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Monte Carlo design evaluation and one-parameter sensitivity analyses",
        "details": "Each trial draws paired team baselines, selects one team per pair by a fair coin, adds the stipulated labour and retention effects, and adds measurement error. The decision uses the resulting paired differences. With 96 teams, 15,459 trials passed the labour criterion and 19,990 passed the retention criterion. In the central design, each team has standard normal latent labour and quality values with correlation 0.3. Within a pair the latent values for a given outcome have correlation 0.7. A latent labour value z maps to baseline hours per initial unit 3 + 7 exp(0.35 z − 0.35²/2). A latent quality value z maps to baseline retention 0.72 + 0.25/(1 + exp(−1.4 z)). Pair differences receive independent zero-mean Gaussian measurement errors with standard deviations sqrt(2) times 0.2 hours per initial unit and sqrt(2) times 0.005 in retained fraction. No pair is lost in the central scenario. The one-sided paired Student t bounds allow 0.2 hours per initial unit and one percentage point for differential bias."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The rates concern hypothetical team-level outcomes. The simulator draws no individual tasks or forecasts, and the planned twenty tasks per team enter the collection budget only. Random simulation error and uncertainty about whether real teams resemble the simulated teams are separate sources of uncertainty."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The rates concern hypothetical team-level outcomes. The simulator draws no individual tasks or forecasts, and the planned twenty tasks per team enter the collection budget only. Random simulation error and uncertainty about whether real teams resemble the simulated teams are separate sources of uncertainty."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Each simulated trial has a known true benefit. The fraction meeting both criteria estimates the probability of detecting that benefit under the chosen assumptions. The design requires the lower 95% Monte Carlo limit on detection to reach 90% in every required benefit scenario. Central pass rates of 44.79% and 77.25% fall short."
    backing [backing_material]
  }

  claim finding {
    statement "Neither candidate trial size qualified under the stated planning criteria. The simulation estimates detection probabilities conditional on a stipulated effect and specified measurement assumptions."
    environment engineering_work
  }

  claim exception_applies {
    statement "The intended trial differs materially from the stipulated effect, between-team variation, matching or measurement assumptions used to calculate these detection rates."
    environment engineering_work
  }

  // With 96 teams and the same random draws, lowering the correlation between teams’
  // latent baselines from 0.7 to 0.2 gave 6,930 passes out of 20,000. Separately
  // increasing the log-scale standard deviation of baseline labour from 0.35 to 0.65 gave
  // 5,677. These changes retain the same stipulated AI benefit.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}
