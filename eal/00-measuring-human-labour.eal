language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_00 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Mathematical arguments with finite hypothetical examples",
        "details": "An engineer spent three hours on one requirement during a four-hour shift. The second half can hold two hours at most. At least an hour fell in the first half, which holds at most two hours. Deriving the three-hour total requires direct observations of time or other evidence about human activity. In independent minute models with work and conditional commit probabilities (1/2, 1/5) and (1/4, 2/5), commits occur with probability 1/10 in both models, while an hour contains 30 or 15 expected active minutes."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Mathematical arguments with finite hypothetical examples",
        "details": "For interval bounds, split time at observed and target boundaries. Integrate each activity over each cell to measure how much of each person’s time it consumes. Their sum for a person cannot exceed the hours available to them in the cell. The minimum and maximum over these cell totals enclose the totals from all feasible allocations. For sampled hours, the expectation of an inclusion indicator divided by its inclusion probability is one. Thus weighting measured hours or fixed prediction errors correctly recovers the total on average. In a hypothetical paired trial, one omitted review hour per initial unit changed a true one-hour saving into an apparent two-hour saving. Counting six failed checks per hundred as passes changed a true five-point retention loss into an apparent one-point gain. Both errors favoured a false benefit decision."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Define which contributors and tasks the measurement covers. Specify the periods during which their hours count. The enclosure depends on valid observation limits and capacity. Design-based unbiasedness requires known positive inclusion probabilities and accurate sampled hours. The prospective causal comparison concerns offering specified AI tools to the enrolled teams on their fixed workloads. The numerical cases are hypothetical."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Define which contributors and tasks the measurement covers. Specify the periods during which their hours count. The enclosure depends on valid observation limits and capacity. Design-based unbiasedness requires known positive inclusion probabilities and accurate sampled hours. The prospective causal comparison concerns offering specified AI tools to the enrolled teams on their fixed workloads. The numerical cases are hypothetical."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Constraints rule out labour totals that cannot fit the observations. A random draw with known inclusion probabilities supports extrapolation because each sampled contribution divided by its chance of selection averages to the actual contribution. Retained functionality must also clear its decision threshold before a labour saving supports a claim of benefit."
    backing [backing_material]
  }

  claim finding {
    statement "A team can bound human labour from time observations and capacity limits or estimate it from a planned random sample of measured hours. A claim of benefit from offering AI also requires independently checked labour and retained functionality."
    environment engineering_work
  }

  claim exception_applies {
    statement "Independent checks found a problem that can change the assessment. A labour estimate may omit part of the work or mismeasure hours. A range may rely on scheduling choices the team cannot make. A follow-up score may bias the comparison."
    environment engineering_work
  }

  // Omitted review hours can change the labour comparison. Inflated follow-up
  // scores can change the retention comparison. Independently verify both groups
  // and bound any hours or functionality the checks leave unresolved.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability,
    premises arg_01.finding, arg_02.finding, arg_03.finding, arg_05.finding, arg_06.finding, arg_09.finding, arg_11.finding, arg_14.finding, arg_15.finding, arg_16.finding, arg_18.finding
  ] via warrant => finding
}

module arg_01 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "proof",
        "details": "Consider two models of one engineer’s work. In each minute the engineer is active with probability p, independently of other minutes. An active engineer commits with probability c, using separate independent draws. Both models allow commits only during activity. The first uses (p, c) = (1/2, 1/5) and averages 30 active minutes per hour. The second uses (p, c) = (1/4, 2/5) and averages 15."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "proof",
        "details": "In both models the probability of a commit in any minute is p times c, which equals one tenth. Independence gives the probability of any specific sequence of n minutes with k commits as (1/10) to the power k times (9/10) to the power n minus k. The expected active time is n times p, so the models give different expectations for every positive n."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The result concerns expected active person-minutes in model classes that include both examples. In the binary model, the engineer works for the full minute whenever the activity indicator is one."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The result concerns expected active person-minutes in model classes that include both examples. In the binary model, the engineer works for the full minute whenever the activity indicator is one."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "When two models give identical probabilities to every observable sequence, those observations cannot determine a quantity on which the models disagree."
    backing [backing_material]
  }

  claim finding {
    statement "Commit observations alone leave expected human working time undetermined across the two activity models."
    environment engineering_work
  }

  claim exception_applies {
    statement "The assumptions exclude one of the activity models, or additional measurements distinguish the amounts of human work the models imply."
    environment engineering_work
  }

  // A verified chance of committing during an active minute can distinguish these models.
  // Interpreting a fitted hidden state as human activity requires evidence about who did the work.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}

module arg_02 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "measurement_definition",
        "details": "During one clock hour an engineer spends 40 minutes instructing and reviewing. Two AI workflows run for 50 and 20 minutes and overlap for 20 minutes. Each run includes the overlap in its own duration, giving 70 workflow-minutes. The engineer supplies 40 person-minutes."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "measurement_definition",
        "details": "At each instant, divide each contributor’s attention among their activities using non-negative shares that sum to at most one. Integrating the shares over elapsed hours and adding the contributions gives total person-hours. For example, two people reviewing together for one hour contribute two person-hours. Measure elapsed time to first acceptance from the moment the task enters the cohort."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Define whose labour counts and the period over which to count it. Specify which activities fall within the task. A task discontinued before acceptance has no first acceptance. When observation ends while the task is still open, the time already elapsed gives a lower bound on time to first acceptance."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Define whose labour counts and the period over which to count it. Specify which activities fall within the task. A task discontinued before acceptance has no first acceptance. When observation ends while the task is still open, the time already elapsed gives a lower bound on time to first acceptance."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Each engineer can devote at most one minute of attention per clock minute. Different engineers can work at the same time. An unattended workflow can run without using anyone’s attention."
    backing [backing_material]
  }

  claim finding {
    statement "Count each person’s labour once across concurrent activities. Measure workflow duration and elapsed time to first acceptance separately."
    environment engineering_work
  }

  claim exception_applies {
    statement "The accounting either double-counts someone’s time or excludes attention they spent waiting. Hours that cannot yet be attributed to a task also leave its labour total uncertain."
    environment engineering_work
  }

  // Waiting consumes labour when someone must attend to the workflow. Include known hours
  // in the bounds for the tasks to which they could belong.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}

module arg_03 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "measurement_definition",
        "details": "Give each original requirement a non-negative score at intake. When a requirement is still unaccepted at the deadline, its retained score is zero. For one accepted by the deadline, multiply the intake score by the fraction of the original requirement still satisfied at the scheduled assessment after acceptance."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "measurement_definition",
        "details": "Suppose a requirement worth two units has two one-unit components. Only the first reaches acceptance by the deadline, and all of its criteria still hold at follow-up. A scoring rule defined at intake can award one unit for that component. A rule that requires timely acceptance of the complete requirement gives zero in the same case. The scoring unit determines how the same work enters the total."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The score uses the criteria and scoring unit set at intake. The deadline determines eligibility and the lag after first acceptance sets the assessment date. Count known labour in the cohort total even when the retained score is zero."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The score uses the criteria and scoring unit set at intake. The deadline determines eligibility and the lag after first acceptance sets the assessment date. Count known labour in the cohort total even when the retained score is zero."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "A common intake rubric fixes the unit of comparison when teams split or implement requirements differently. Assess the delivered behaviour at the stated lag against the same criteria."
    backing [backing_material]
  }

  claim finding {
    statement "Fix the scoring rule and original requirements at intake. For timely acceptances, base the retained score on the fraction of the original requirement still satisfied at follow-up."
    environment engineering_work
  }

  claim exception_applies {
    statement "The follow-up assessment is unavailable or cannot establish which original criteria still hold. A change to the original scoring basis also changes what the score measures."
    environment engineering_work
  }

  // The retained fraction of an accepted requirement remains unknown until a follow-up
  // assessment establishes it. If the scope changed, use the original criteria to assess
  // the original requirement or state which requirement the assessment now covers.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}

module arg_04 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "finite_schedule_enumeration",
        "details": "Divide a two-hour shift into four half-hour periods. One engineer implements a feature in two periods and can use either remaining period for repair. There are 6 schedules with zero repair periods and 12 with one. Using both remaining periods gives 6. The reviewer works in any one of the four periods, giving 96 equally weighted schedules in all. The observations give the engineer’s shift totals by activity and the reviewer’s first-hour total. The known first-hour total comes from counting both people’s occupied periods and multiplying by half an hour."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "finite_schedule_enumeration",
        "details": "Let r be the engineer’s total repair time in hours and s be the observed first-hour review time. Separate limits give first-hour bounds [s, 1 + r + s]. Shared capacity gives [r + s, 1 + s] because the engineer can fit at most one hour of their work into either hour. The average value of r across these schedules is 0.5. A lower bound above one establishes an excess over one person-hour. An upper bound of one or less rules out an excess. Counting the cases gives 12 correct decisions under separate limits and 60 under shared capacity. Both ranges contain the known total every time, leaving 84 and 36 decisions unresolved respectively."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The mean widths of 1.5 and 0.5 person-hours apply to the 96 schedules with the stated observations. The decision counts come from testing a strict one-person-hour threshold in those schedules."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The mean widths of 1.5 and 0.5 person-hours apply to the 96 schedules with the stated observations. The decision counts come from testing a strict one-person-hour threshold in those schedules."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Two activities can reach their separate maxima in different schedules. Combining those maxima can require a contributor to use the same time twice. One capacity constraint across both activities rules out that allocation."
    backing [backing_material]
  }

  claim finding {
    statement "A shared time budget can reduce the range of possible person-hours and resolve threshold decisions when several activities draw on the same contributor."
    environment engineering_work
  }

  claim exception_applies {
    statement "The range excludes a contributor whose labour belongs in the target total."
    environment engineering_work
  }

  // Omitting the reviewer puts the upper bound at one hour in all 96 cases. The engineer
  // fills the first hour in 13 of their 24 schedules. The reviewer works in that hour in
  // two of four placements. The true total exceeds one hour in the resulting 26 cases,
  // which the bound classifies incorrectly. Its mean width is still 0.5 person-hours.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}

module arg_05 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "proof",
        "details": "Take a time span containing every observation period and target window. Divide the span at each of their start and end times. Within each resulting interval, use a variable for the non-negative hours a person spends on a particular task activity. The sum for each person is at most the interval duration. Each observation bounds the sum of its covered variables over whole intervals. The target weights each variable by a fixed value for its interval and adds the results."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "proof",
        "details": "Each variable lies between zero and its interval’s duration. The linear constraints give a closed convex set, and the duration limits make it bounded. A nonempty set has a minimum and maximum for the linear target. Any weighted average of two endpoint allocations is feasible, and its target is the same weighted average of the endpoint totals. The within-interval block allocation then realises that intermediate value."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Specify the contributors covered by each observation and by the labour target. Exact attainability requires the scheduling model to permit the placement of the required activity blocks within each interval. An empty feasible set means the observations and constraints admit no allocation."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Specify the contributors covered by each observation and by the labour target. Exact attainability requires the scheduling model to permit the placement of the required activity blocks within each interval. An empty feasible set means the observations and constraints admit no allocation."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Integrating any admissible allocation over each interval gives variables that meet the constraints. To realise a feasible set of variables, give each of a person’s activities one consecutive block of the specified length inside the interval. The duration limit leaves room for every block, with any time left over idle. The resulting schedule reproduces the observations and the target."
    backing [backing_material]
  }

  claim finding {
    statement "In a nonempty feasible allocation model, the minimum and maximum of the linear programme give the exact endpoints of the attainable range of the weighted labour total."
    environment engineering_work
  }

  claim exception_applies {
    statement "Workplace rules prevent one or more of the required activity blocks or switches between them."
    environment engineering_work
  }

  // A minimum uninterrupted duration or task dependency can exclude some block allocations.
  // The linear programme still encloses every permissible total if it retains the true
  // observations and capacity limits. Such workplace rules may leave gaps between attainable
  // totals even when both endpoints are feasible.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability,
    premises arg_02.finding
  ] via warrant => finding
}

module arg_06 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "proof",
        "details": "Write the finite linear constraints as Ax ≤ b for a non-negative vector x and let wᵀx be the target. Non-negative multipliers λ and μ satisfying Aᵀλ ≥ w and Aᵀμ ≥ −w bound every feasible target between −μᵀb and λᵀb. A feasible x attaining either bound verifies the corresponding endpoint."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "proof",
        "details": "Linear programming duality supplies matching multipliers for this nonempty bounded model. The probability that any observation range fails to cover its true value is at most the sum of their individual failure probabilities. When this sum is at most α, all the ranges cover simultaneously with probability at least 1 − α, even when the failures are dependent. Under valid structural constraints the computed extrema then enclose the true target."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Take 0 < α < 1 and repeat the observation procedure. The guarantee transfers simultaneous coverage of at least 1 − α from the input ranges to the target under valid structural constraints. An empty feasible set counts as a coverage failure."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Take 0 < α < 1 and repeat the observation procedure. The guarantee transfers simultaneous coverage of at least 1 − α from the input ranges to the target under valid structural constraints. An empty feasible set counts as a coverage failure."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Since x ≥ 0, the condition Aᵀλ ≥ w gives wᵀx ≤ λᵀAx. Since λ ≥ 0, Ax ≤ b gives λᵀAx ≤ λᵀb. Repeating the calculation with μ and −w gives the lower bound. If every input range covers its true value and the structural constraints hold, the true labour gives a feasible vector."
    backing [backing_material]
  }

  claim finding {
    statement "A feasible allocation that matches a dual bound verifies the corresponding labour endpoint. Valid structural constraints transfer simultaneous coverage of the input ranges to coverage of the target range."
    environment engineering_work
  }

  claim exception_applies {
    statement "The input ranges do not have the required simultaneous coverage, or the structural constraints exclude the true allocation."
    environment engineering_work
  }

  // Coverage for individual observations can overstate the probability that all observation
  // ranges cover together. Checking endpoints leaves open whether the observations include
  // all the work needed for the target.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability,
    premises arg_05.finding
  ] via warrant => finding
}

module arg_07 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "proof",
        "details": "Let z_k be cumulative labour from a common start to time boundary k. Encode z_q − z_p ≤ c as a directed edge from p to q with weight c. An interval of duration d gives a forward edge of weight d between its endpoints and a reverse edge of weight zero. An observed range of l to u hours gives a forward edge of weight u and a reverse edge of weight −l."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "proof",
        "details": "Let D(r,k) be the shortest-path distance from r to k. For a root r, set z_k to D(r,k) minus D(r,0). For every edge from i to j with weight c, D(r,j) is at most D(r,i) plus c, so these cumulative values satisfy every edge constraint. The adjacent values increase by a non-negative amount that fits within the interval. Allocate that many hours, or use a constant share equal to that amount divided by the duration. The root p gives the upper bound and the root q the lower bound. Convex combinations realise the intermediate totals."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The graph describes one person doing one task activity. Each observation and target period starts and ends at a vertex. Edges in both directions between consecutive vertices make all required distances finite if there is no negative cycle."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The graph describes one person doing one task activity. Each observation and target period starts and ends at a vertex. Edges in both directions between consecutive vertices make all required distances finite if there is no negative cycle."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Adding the inequalities along a path cancels the intermediate cumulative totals. A negative cycle would require zero to be at most a negative value. In its absence the shortest path from p to q gives an upper bound of D(p,q). The reverse shortest path gives the lower bound −D(q,p)."
    backing [backing_material]
  }

  claim finding {
    statement "For one allocation stream, a graph of differences detects inconsistent constraints and gives the exact attainable labour range for a period whose endpoints are vertices."
    environment engineering_work
  }

  claim exception_applies {
    statement "The calculation treats two allocations that draw on the same person’s time as independent."
    environment engineering_work
  }

  // Separate graphs can each allocate the same person’s time. Couple the allocations under
  // one capacity constraint when observations or the target include competing activities.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability,
    premises arg_05.finding
  ] via warrant => finding
}

module arg_08 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Mathematical derivation and worked example",
        "details": "Consider a cohort whose labour H lies between one and two person-hours and whose retained output Q equals twice H."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Mathematical derivation and worked example",
        "details": "Every feasible pair has a rate of two units per person-hour. Using separate marginal limits gives an outer range from one to four by combining the smallest output with the largest labour total and the largest output with the smallest labour total. The constraint Q equals twice H excludes both combinations."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The result applies to pairs satisfying the stated constraints with positive labour. The rate is undefined at zero labour."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The result applies to pairs satisfying the stated constraints with positive labour. The rate is undefined at zero labour."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Optimise Q divided by H over feasible pairs. The rate r bounds productivity from above exactly when every feasible pair with H positive satisfies Q minus r times H less than or equal to zero."
    backing [backing_material]
  }

  claim finding {
    statement "Sharp deterministic productivity bounds come from optimising the ratio over feasible pairs of retained output and positive labour."
    environment engineering_work
  }

  claim exception_applies {
    statement "Reject a purported sharp range if it includes an undefined rate at zero labour or its endpoints depend on pairs excluded by the observations. If the feasible rate is unbounded as labour approaches zero, any finite range also fails."
    environment engineering_work
  }

  // If labour can approach zero with output fixed and positive, the rate has no finite
  // upper bound. If every feasible allocation has zero labour, report the two totals.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability,
    premises arg_03.finding, arg_05.finding
  ] via warrant => finding
}

module arg_09 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Proposition and proof",
        "details": "Take a finite set of eligible contributor intervals. For each interval let y be actual labour and pi its known positive inclusion probability. Fix any prediction f before the draw. Measure labour accurately for every sampled interval."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Proposition and proof",
        "details": "Add the weighted residuals to the sum of the fixed predictions. The expectation equals total actual labour. Setting every prediction to zero gives the Horvitz–Thompson estimator."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The expectation is over repeated draws from the stated frame, holding actual labour and predictions fixed. Use the probabilities from the sampling design and accurate measured hours."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The expectation is over repeated draws from the stated frame, holding actual labour and predictions fixed. Use the probabilities from the sampling design and accurate measured hours."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "The inclusion indicator I has expectation pi under the sampling design. The weighted residual I times (y minus f) divided by pi therefore has expectation y minus f. This uses only the probability of selecting the individual interval."
    backing [backing_material]
  }

  claim finding {
    statement "Inverse-probability weighting gives a design-unbiased estimate of total labour in the stated frame. Fixed predictions can supply the starting total before residuals are added."
    environment engineering_work
  }

  claim exception_applies {
    statement "The sampling excludes eligible work, uses incorrect selection chances, measures some selected intervals inaccurately or fits the predictions using the same correction sample."
    environment engineering_work
  }

  // Contributors absent from the frame have no chance of inclusion. The argument also
  // requires correct weights and accurate replies. Fitting the prediction to the correction
  // sample can change the expected residual contribution.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}

module arg_10 {
