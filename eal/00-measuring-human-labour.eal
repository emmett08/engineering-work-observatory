    input {
      "material": {
        "role": "backing",
        "classification": "Randomised design and finite-population identity",
        "details": "Suppose teams A and B form a pair. If A receives the offer, the comparison uses A’s outcome with access minus B’s outcome without access. The other coin outcome exchanges their roles. Add these two differences and group the terms by team. Dividing by two gives the average of the effects of access on A and B."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
