language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_00 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Mathematical arguments with finite hypothetical examples",
        "details": "An engineer spent three hours on one requirement during a four-hour shift. At most two hours fit in the second half, and at most two hours fit in the first, so first-half labour lies between one and two person-hours. Commit data alone do not supply that three-hour total. In independent minute models with work and conditional commit probabilities (1/2, 1/5) and (1/4, 2/5), commits occur with probability 1/10 in both models, while an hour contains 30 or 15 expected active minutes."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Mathematical arguments with finite hypothetical examples",
        "details": "For interval bounds, split time at observed and target boundaries. Integrating any feasible work history gives a cell total for each activity and never exceeds one person-hour per available hour per person. Minimising and maximising the target over those totals encloses all such histories. For sampled hours, the expectation of an inclusion indicator divided by its inclusion probability is one. Thus weighting measured hours or fixed prediction errors correctly recovers the total on average. In a hypothetical paired trial, one omitted review hour per initial unit changed a true one-hour saving into an apparent two-hour saving. Six incorrectly credited checks per hundred changed a true five-point retention loss into an apparent one-point gain. Both errors favoured a false benefit decision."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The time and sampling arguments require a defined population of contributors, tasks and observation windows. The enclosure depends on valid observation limits and capacity. Design-based unbiasedness requires known positive inclusion probabilities and accurate sampled hours. The prospective causal comparison concerns offering specified AI tools to the enrolled teams on their fixed workloads. The numerical cases are hypothetical."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The time and sampling arguments require a defined population of contributors, tasks and observation windows. The enclosure depends on valid observation limits and capacity. Design-based unbiasedness requires known positive inclusion probabilities and accurate sampled hours. The prospective causal comparison concerns offering specified AI tools to the enrolled teams on their fixed workloads. The numerical cases are hypothetical."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Constraints rule out labour totals that cannot fit the observations. A random draw with known inclusion probabilities supports extrapolation because each sampled contribution divided by its chance of selection averages to the actual contribution. Retained functionality must also clear its decision threshold before a labour saving supports a claim of benefit."
    backing [backing_material]
  }

  claim finding {
    statement "A team can bound human labour from time observations and capacity limits or estimate it from a planned random sample of measured hours. A claim of benefit from offering AI also requires independently checked labour and retained functionality."
    environment engineering_work
  }

  claim exception_applies {
    statement "Independent checks found missing work, inaccurate task hours, scheduling restrictions or biased functionality scores that can change the assessment."
    environment engineering_work
  }

  // Missing review time or inflated follow-up scores can change a decision. Require
  // independent checks in both groups, and retain a supported range for any unresolved
  // hours or functionality.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability,
    premises arg_01.finding, arg_02.finding, arg_03.finding, arg_05.finding, arg_06.finding, arg_09.finding, arg_11.finding, arg_14.finding, arg_15.finding, arg_16.finding, arg_18.finding
  ] via warrant => finding
}

module arg_01 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "proof",
        "details": "Consider two models of one engineer's work. Draw an activity indicator independently each minute, with probability p of activity. Conditional on activity, the engineer commits with probability c, using independent draws. The two models use (p, c) = (1/2, 1/5) and (1/4, 2/5). Over one hour their mean active times are 30 and 15 minutes respectively."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "proof",
        "details": "In either model the probability of a commit in a minute is p times c, which equals one tenth. By independence, any particular n-minute sequence with k commits has probability (1/10) raised to k times (9/10) raised to n minus k, under both models. Mean active time is n times p. Even complete commit sequences over arbitrary finite periods leave this difference unresolved."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The result concerns the expected count of active person-minutes in any model class that contains both examples. A minute of activity means the engineer was working during that minute in this binary model."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The result concerns the expected count of active person-minutes in any model class that contains both examples. A minute of activity means the engineer was working during that minute in this binary model."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "When two models give exactly the same probabilities to every observable sequence, those observations cannot distinguish a quantity the models disagree about."
    backing [backing_material]
  }

  claim finding {
    statement "Commit observations alone do not identify mean active human time across the activity models in the counterexample."
    environment engineering_work
  }

  claim exception_applies {
    statement "The model class for the intended inference excludes one of the two activity processes or includes measurements that distinguish their implied human activity."
    environment engineering_work
  }

  // A verified emission probability, a model constraint that excludes one construction,
  // or separate observations that distinguish the two models can remove this ambiguity. A
  // fitted hidden state requires evidence linking it to human work.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}

module arg_02 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "measurement_definition",
        "details": "In one elapsed hour an engineer spends 40 minutes instructing and reviewing. Two AI workflows run for 50 and 20 minutes, with 20 minutes of overlap. The overlap contributes to both runs, so the workflows account for 70 workflow-minutes. The engineer supplies 40 person-minutes."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "measurement_definition",
        "details": "For each contributor at each instant, give every covered activity a non-negative share of their time. The sum of those shares is at most one. Integrate each share over elapsed hours and add the results across activities and contributors. For example, two people reviewing together for one hour contribute two person-hours. Define elapsed time until first acceptance by subtracting the intake time from the first acceptance time."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The labour total covers the declared contributors, activities and time windows. Distinguish permanent discontinuation from observation ending before acceptance. The latter leaves the elapsed time to acceptance unknown beyond the last observed time."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The labour total covers the declared contributors, activities and time windows. Distinguish permanent discontinuation from observation ending before acceptance. The latter leaves the elapsed time to acceptance unknown beyond the last observed time."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "A person has one minute of available attention per clock minute. Separate engineers can use their own minutes concurrently, and a workflow can continue through intervals when no engineer attends to it."
    backing [backing_material]
  }

  claim finding {
    statement "Account for each person’s labour once across concurrent activities, and report workflow duration and elapsed time until acceptance as separate quantities."
    environment engineering_work
  }

  claim exception_applies {
    statement "The totals used for this comparison count a person's time twice, omit attention spent waiting or leave material work attribution unresolved."
    environment engineering_work
  }

  // Waiting consumes labour when a person must attend to the workflow. When known hours
  // could belong to several tasks, carry the unresolved allocation into the bounds
  // instead of treating those hours as zero.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}

module arg_03 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "measurement_definition",
        "details": "Fix a non-negative score for each original requirement before work starts. Score zero for a requirement known to miss the acceptance deadline. For one accepted by the deadline, multiply its original score by the fraction of the original requirement still satisfied at the scheduled assessment after acceptance."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "measurement_definition",
        "details": "Suppose a requirement worth two units has two one-unit components. One meets the deadline and remains fully satisfied at follow-up. The other misses the deadline. Prespecified additive component scoring gives one unit. Under a prespecified rule that requires acceptance of the complete requirement, the same events give zero. This difference shows why the scoring unit must be fixed before outcomes are observed."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The score depends on the intake requirements, the scoring unit, the deadline and the lag after acceptance. Known labour for requirements with zero output credit still belongs in the cohort total."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The score depends on the intake requirements, the scoring unit, the deadline and the lag after acceptance. Known labour for requirements with zero output credit still belongs in the cohort total."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "A common intake rubric keeps the unit of comparison fixed even when teams implement or split requirements differently. A later assessment checks whether the delivered behaviour still holds at the stated lag."
    backing [backing_material]
  }

  claim finding {
    statement "Fix the scoring rule and original work scope at intake, then credit timely acceptance by the fraction of that scope still satisfied at the scheduled follow-up."
    environment engineering_work
  }

  claim exception_applies {
    statement "A follow-up assessment is missing, the original scoring basis changed, or reviewers cannot determine which parts of the intake requirement still hold."
    environment engineering_work
  }

  // If no follow-up assessment was made, the retained fraction of a timely acceptance
  // remains unknown. If material scope changed during development, judge the original
  // requirement or disclose a different target.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}

module arg_04 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "synthetic_enumeration",
        "details": "Divide a two-hour shift into four half-hour periods. Place two periods of implementation and zero, one or two periods of repair in distinct slots for one engineer. There are 6, 12 and 6 possible schedules respectively. A reviewer works in any single slot, giving 96 equally weighted histories. Observe the engineer's shift totals by activity and the reviewer's first-hour total. Count both people's occupied slots in the first hour to obtain the true labour."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "synthetic_enumeration",
        "details": "Let r be the engineer's total repair time in hours and s be the observed first-hour review time. Separate capacity limits give first-hour bounds [s, 1 + r + s]. Shared capacity gives [r + s, 1 + s] because one hour of total engineer labour can fit in the second hour and at most one in the first. The mean of r is 0.5. Correct decisions about exceeding one person-hour require the lower bound to exceed one or the upper bound to be at most one. Counting the cases gives 12 correct and 84 unresolved with separate limits, and 60 correct and 36 unresolved with shared capacity. Both contain the true total in every case."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The mean widths of 1.5 and 0.5 person-hours and the classification counts describe this finite constructed design with these observations and the strict one-person-hour threshold. The calculation makes no claim about the frequency of these conditions in workplaces."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The mean widths of 1.5 and 0.5 person-hours and the classification counts describe this finite constructed design with these observations and the strict one-person-hour threshold. The calculation makes no claim about the frequency of these conditions in workplaces."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "An activity can reach its separate maximum in a schedule that uses time the contributor would need for another activity. Applying one capacity constraint to both activities excludes these incompatible totals."
    backing [backing_material]
  }

  claim finding {
    statement "Enforcing a shared time budget can narrow labour ranges and resolve threshold decisions when several activities draw on the same person."
    environment engineering_work
  }

  claim exception_applies {
    statement "The proposed use of the shared-capacity range excludes a contributor whose labour belongs to the target total."
    environment engineering_work
  }

  // If the reviewer is omitted, the upper bound is one and all 96 cases appear to be at
  // or below the threshold. The engineer fills both first-hour slots in 13 of their 24
  // schedules. When the reviewer also works there, which occurs in two of the four
  // placements, true labour exceeds one person-hour. This gives 26 wrong decisions even
  // though the mean width stays at 0.5 person-hours.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}

module arg_05 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "proof",
        "details": "Split the calendar at all observation and target boundaries. Each time cell has a positive duration. The variables are non-negative hours for each person, task and activity in that cell. Their sum for a person cannot exceed the cell duration. Each observation bounds the sum of its covered variables across whole cells. The target is the sum of those variables multiplied by weights fixed within each cell."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "proof",
        "details": "The finitely many variables are bounded by their cell durations, and the linear constraints define a closed convex set. If it is nonempty, the linear target attains a minimum and maximum. Every weighted average of their feasible arrays is feasible, and its target is the same weighted average of the endpoint totals. The allocation construction realises each interior value as well."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Exact attainability requires a calendar wide enough to contain all observations and a scheduling model that permits the block allocation within each cell. The observations and the target must refer to the covered contributors. If the feasible set is empty, the observations and constraints admit no history."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Exact attainability requires a calendar wide enough to contain all observations and a scheduling model that permits the block allocation within each cell. The observations and the target must refer to the covered contributors. If the feasible set is empty, the observations and constraints admit no history."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Integrating any admissible history gives variables that meet these constraints. Conversely, take any feasible array. In each person's cell, allot one consecutive block of the specified length to each activity and leave the unused duration idle. This reproduces all observed sums and the target."
    backing [backing_material]
  }

  claim finding {
    statement "For a non-empty feasible allocation model, the minimum and maximum of its linear programme delimit exactly the attainable values of a cellwise linear labour target."
    environment engineering_work
  }

  claim exception_applies {
    statement "The scheduling constraints for the intended workplace forbid the within-cell switching or placements used to establish these endpoints."
    environment engineering_work
  }

  // Minimum uninterrupted periods or precedence constraints can rule out some block
  // allocations. The linear programme still encloses every total allowed by those
  // stricter constraints if it retains all the genuine observations and capacity limits.
  // Even when both endpoints are possible, interior values need not be possible under the
  // stricter rules.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability,
    premises arg_02.finding
  ] via warrant => finding
}

module arg_06 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "proof",
        "details": "Write the finite linear constraints as Ax ≤ b with non-negative vector x, and express the target as the weighted sum wᵀx. If non-negative multipliers λ and μ satisfy Aᵀλ ≥ w and Aᵀμ ≥ −w, every feasible target falls between −μᵀb and λᵀb. A feasible x that gives either bound proves it is the respective endpoint."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "proof",
        "details": "Linear programming duality provides matching multipliers for this nonempty bounded model. For random input ranges, the probability that at least one fails is at most the sum of their individual failure probabilities. If that sum is at most α, the event that every range covers has probability at least 1 − α, without requiring independence. On that event the true target lies between the computed extrema."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Take 0 < α < 1. The coverage claim concerns repetitions of the observation procedure and requires actual joint input coverage at least 1 − α together with valid structural constraints. Count an empty feasible set as a coverage failure."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Take 0 < α < 1. The coverage claim concerns repetitions of the observation procedure and requires actual joint input coverage at least 1 − α together with valid structural constraints. Count an empty feasible set as a coverage failure."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "From x ≥ 0 we get wᵀx ≤ λᵀAx. From λ ≥ 0 and Ax ≤ b we get λᵀAx ≤ λᵀb. Applying the same reasoning to −w gives the lower bound. If all the input observation ranges cover the true observed quantities, the true hours form a feasible vector whenever the structural constraints hold."
    backing [backing_material]
  }

  claim finding {
    statement "Feasible allocations and matching dual bounds certify labour endpoints. The resulting interval inherits a simultaneous coverage guarantee for the observation limits when the structural constraints also hold."
    environment engineering_work
  }

  claim exception_applies {
    statement "The input intervals lack the stated simultaneous coverage or the structural constraints exclude the true work history."
    environment engineering_work
  }

  // Each observation interval can have adequate marginal coverage while their combined
  // coverage falls below the required level. Formal endpoint checks also leave open
  // whether the observations cover the contributors and hours of interest.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability,
    premises arg_05.finding
  ] via warrant => finding
}

module arg_07 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "proof",
        "details": "Let z_k be the cumulative labour from a common starting time to calendar boundary k. Encode every constraint z_q − z_p ≤ c as a directed edge from p to q with weight c. For adjacent boundaries a cell of duration d has forward edge weight d and reverse weight zero. An observation that bounds the intervening work between l and u has forward edge weight u and reverse weight −l."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "proof",
        "details": "Given a root r, set z_k to D(r,k) minus D(r,0). Every edge from i to j of weight c satisfies D(r,j) ≤ D(r,i) + c, so z satisfies that edge constraint. Adjacent inequalities guarantee that the increase in each cell fits its duration. A constant work share equal to the increase divided by cell duration realises those hours. Rooting at p and at q attains the upper and lower bounds respectively. Convex combinations realise intermediate values."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The graph covers one person performing one activity on one task. The observation and target endpoints must be vertices. There are edges in both directions between consecutive vertices, so the required shortest-path distances are finite when no negative cycle exists."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The graph covers one person performing one activity on one task. The observation and target endpoints must be vertices. There are edges in both directions between consecutive vertices, so the required shortest-path distances are finite when no negative cycle exists."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Adding the inequalities along a path cancels the intermediate cumulative totals. A cycle of negative sum would require zero to be no greater than a negative number. In the absence of such a cycle, the shortest path from p to q bounds the labour above by D(p,q). The reverse shortest path bounds it below by −D(q,p)."
    backing [backing_material]
  }

  claim finding {
    statement "For one allocation stream, a difference-constraint graph detects infeasibility and gives the exact attainable labour range over any interval whose endpoints are graph vertices."
    environment engineering_work
  }

  claim exception_applies {
    statement "The proposed single-stream calculation treats competing allocations of the same person's time as if they were independent."
    environment engineering_work
  }

  // Separate graphs for concurrent tasks can each allocate the same person's available
  // time. A shared-capacity model is needed when the target or observations couple those
  // tasks.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability,
    premises arg_05.finding
  ] via warrant => finding
}

module arg_08 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Mathematical derivation and worked example",
        "details": "Consider a cohort whose labour H lies between one and two person-hours and whose retained output Q equals twice H."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Mathematical derivation and worked example",
        "details": "Every allowed pair has a rate of two units per person-hour. Dividing separate marginal limits permits 2 divided by 2 and 4 divided by 1, an outer range from one to four. Neither of those extreme pairs can occur."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Sharpness applies to the stated feasibility constraints and the pairs with positive labour. The rate has no value at zero labour."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Sharpness applies to the stated feasibility constraints and the pairs with positive labour. The rate has no value at zero labour."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Optimising Q divided by H over feasible pairs respects the dependence between the outcomes. For positive labour, a rate r is an upper bound exactly when Q minus r times H is nonpositive for every feasible pair."
    backing [backing_material]
  }

  claim finding {
    statement "Sharp deterministic productivity bounds must respect jointly feasible output and positive labour totals."
    environment engineering_work
  }

  claim exception_applies {
    statement "The proposed finite productivity range uses zero labour, allows labour arbitrarily close to zero at positive output, or assumes an output and labour pairing excluded by the evidence."
    environment engineering_work
  }

  // If compatible positive labour approaches zero while output stays fixed and positive,
  // the rates have no finite upper bound. If all histories have zero labour, report both
  // totals separately.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability,
    premises arg_03.finding, arg_05.finding
  ] via warrant => finding
}

module arg_09 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Proposition and proof",
        "details": "Let U be the finite set of eligible contributor intervals. Each interval has actual labour y, known positive inclusion probability pi, and an optional prediction f fixed before the draw. Every sampled labour allocation is measured accurately."
      }
    }
