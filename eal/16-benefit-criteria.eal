language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_16 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Proposed decision rule and conditional test logic",
        "details": "For each matched pair, subtract the comparison team’s outcome from the AI team’s outcome. Labour is measured in post-intake person-hours per unit of the initial requirement score. Retention is the fraction of that initial score still satisfied at follow-up. Across pairs, take the one-sided 97.5% upper bound on the mean labour difference and add 0.2 person-hours per initial unit. Take the one-sided 97.5% lower bound on the mean retention difference and subtract one percentage point. A benefit declaration requires the first adjusted bound to fall below −1 and the second to exceed −0.05."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Proposed decision rule and conditional test logic",
        "details": "If at least one true effect fails its criterion, a false joint declaration must also falsely declare that criterion satisfied. When each individual procedure limits that error to 2.5%, the probability of a false joint declaration is at most 2.5%, whatever the dependence between outcomes."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "These thresholds are provisional engineering judgements. The adjustments protect only against group differences in measurement error within their respective allowances. Student t bounds use one fewer degree of freedom than there are independent pairs and are exact for identically distributed normal pair differences. Under other distributions they are approximate."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "These thresholds are provisional engineering judgements. The adjustments protect only against group differences in measurement error within their respective allowances. Student t bounds use one fewer degree of freedom than there are independent pairs and are exact for identically distributed normal pair differences. Under other distributions they are approximate."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "The two inequalities answer different engineering questions. The first establishes a worthwhile labour saving. The second rules out a loss of five percentage points or more in retained requirements. The proposed decision requires both results."
    backing [backing_material]
  }

  claim finding {
    statement "A benefit declaration requires evidence of a saving greater than one person-hour per initial unit and a loss smaller than five percentage points in the retained fraction."
    environment engineering_work
  }

  claim exception_applies {
    statement "Independent checks show that differential measurement error can move either adjusted outcome across its benefit threshold."
    environment engineering_work
  }

  // A precisely measured retention loss of four percentage points can pass. A severe
  // defect in a particular requirement can coexist with a passing average retained score.
  // An adoption decision that includes such defects needs separate evidence.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}
