language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_14 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Algebraic derivation and counterexamples",
        "details": "Fix intake forecasts f and g before drawing the validation sample. Score both against the same estimate of actual labour H. Under the sampling design the estimate has expectation H and finite variance."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Algebraic derivation and counterexamples",
        "details": "For one task the difference in squared errors is (f minus g) times (f plus g minus twice estimated labour). It has design variance equal to four times (f minus g) squared times the estimate's variance. If tasks share sampled shifts, their score differences can covary."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Cancellation holds in expectation for paired squared-error differences against the same unbiased estimate. The observed ranking retains sampling uncertainty."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Cancellation holds in expectation for paired squared-error differences against the same unbiased estimate. The observed ranking retains sampling uncertainty."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "The expected squared error against an unbiased estimate equals the true squared error plus the estimate's sampling variance. Subtracting the two expected squared errors cancels that shared variance term."
    backing [backing_material]
  }

  claim finding {
    statement "Scoring two fixed forecasts against the same unbiased estimate of labour preserves their expected difference in squared errors. Measures such as absolute error and interval coverage may require independently checked hours."
    environment engineering_work
  }

  claim exception_applies {
    statement "Systematic labour measurement error can distort the comparison. A different scoring method requires its own argument about measurement uncertainty."
    environment engineering_work
  }

  // Bias b in measured labour shifts the expected score difference by minus twice
  // (f minus g) times b. Omitting one hour from a four-hour task makes a three-hour
  // forecast look exact. Check actual labour independently or bound it to assess
  // absolute error and interval coverage.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}
