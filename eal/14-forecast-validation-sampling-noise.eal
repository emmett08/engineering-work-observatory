language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_14 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Algebraic derivation and counterexamples",
        "details": "Hold intake forecasts f and g fixed across validation draws. Compare both to the same sample estimate of fixed actual labour H, with design expectation H and finite design variance."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Algebraic derivation and counterexamples",
        "details": "For one task the score difference is (f minus g) times (f plus g minus twice estimated labour). Its design variance is four times (f minus g) squared times the labour estimate's variance. Shared sampled shifts can induce covariance across task scores."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Cancellation holds in expectation for paired squared-error differences against the same unbiased estimate. The observed ranking retains sampling uncertainty."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Cancellation holds in expectation for paired squared-error differences against the same unbiased estimate. The observed ranking retains sampling uncertainty."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Expanding the squared forecast error against the sampled estimate adds the estimate's variance to the true squared error in expectation. Unbiased measurement makes the cross term vanish. The common variance term then cancels in the expected difference."
    backing [backing_material]
  }

  claim finding {
    statement "Two fixed forecasts can be compared by their expected squared-error difference against a common unbiased sampled reference, while other accuracy measures may need an audit."
    environment engineering_work
  }

  claim exception_applies {
    statement "The labour reference systematically misses or overstates hours, or the comparison uses a measure for which the common squared-error calculation does not apply."
    environment engineering_work
  }

  // Systematic labour bias b shifts the expected comparison by minus twice the product of
  // (f minus g) and b. Omitting an hour from a four-hour task makes a three-hour forecast
  // look exact. Absolute error and coverage require credible audit values or defensible
  // bounds on actual labour.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}
