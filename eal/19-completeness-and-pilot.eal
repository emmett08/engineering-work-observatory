language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_19 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Probability bound, exact binomial limit and conditional simulation",
        "details": "Under the proposed benefit rule, each team must supply both post-intake labour per initial requirement unit and the fraction of the initial score retained. If each pair independently has a 0.5% chance of missing an outcome, the chance of complete data is 88.7% with 24 pairs and 78.6% with 48 pairs. Both ceilings fall below the 90% detection target. In 20,000 simulated 48-pair trials, 4,212 had incomplete outcomes and could not declare a benefit."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Probability bound, exact binomial limit and conditional simulation",
        "details": "In a proposed pilot of six pairs, the chance of seeing no losses is (1−q)^6. Setting that probability to 0.05 gives a one-sided exact 95% upper limit of 1−0.05^(1/6), approximately 39.3%, after zero observed losses. A pilot of this size consequently cannot establish that the loss probability is as small as 0.5%."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "This numerical ceiling requires common independent pair losses and the all-complete decision rule. The proposed six-pair pilot, with six initial tasks per team, can examine contributors’ reporting burden and the causes of missing labour or follow-up assessments."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "This numerical ceiling requires common independent pair losses and the all-complete decision rule. The proposed six-pair pilot, with six initial tasks per team, can examine contributors’ reporting burden and the causes of missing labour or follow-up assessments."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "A benefit declaration is possible only when every pair is complete. If each of m independent pairs has the same loss probability q, the probability of that event is (1−q)^m, even if every complete trial could detect the true benefit."
    backing [backing_material]
  }

  claim finding {
    statement "Requiring complete outcomes from every pair caps the probability of declaring benefit, and a six-pair pilot cannot establish that incomplete pairs are rare."
    environment engineering_work
  }

  claim exception_applies {
    statement "Pair losses are dependent or the intended decision rule permits decisions with incomplete pairs, so the independent all-complete calculation does not apply."
    environment engineering_work
  }

  // If a single outage removes outcomes for all pairs with probability 0.5% and otherwise
  // every pair is complete, each pair still has a 0.5% risk of loss but the chance of
  // complete data is 99.5% at either size. A procedure permitting decisions with partial
  // data would need prespecified bounds and an assessment of its own error rates.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}
