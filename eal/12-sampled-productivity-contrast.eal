language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_12 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Finite counterexample and confidence-set argument",
        "details": "Consider two intervals with one and three person-hours, and six units of cohort output. Drawing one interval uniformly gives equally likely inverse-probability labour estimates of two and six hours."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Finite counterexample and confidence-set argument",
        "details": "The plug-in rates three and one average to two, while the true rate is six divided by four, or 1.5. The contrast variance adds output variance and p squared times labour variance, then subtracts twice p times their covariance."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The rate requires positive actual labour. The confidence set requires valid contrast intervals for the sampling design that produced both outcome estimates."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The rate requires positive actual labour. The confidence set requires valid contrast intervals for the sampling design that produced both outcome estimates."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "The reciprocal is nonlinear. At the true rate p and positive labour H, the contrast Q minus p times H equals zero. The set of candidate rates whose valid contrast intervals contain zero therefore covers the true rate with at least the confidence level of the contrast interval."
    backing [backing_material]
  }

  claim finding {
    statement "An unbiased labour estimate may bias a plug-in productivity ratio. A valid output-minus-rate-times-labour contrast supports inference on productivity."
    environment engineering_work
  }

  claim exception_applies {
    statement "The proposed rate calculation divides by a zero or negative estimate of hours, or the procedure for the contrast fails its stated coverage conditions."
    environment engineering_work
  }

  // For zero or negative estimated hours, report the component estimates without a point
  // ratio. A valid confidence set can be unbounded.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}
