language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_12 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Finite counterexample and confidence-set argument",
        "details": "The cohort produces six output units. Its two intervals contain one and three person-hours. Selecting one interval uniformly and applying inverse-probability weighting gives estimates of two and six hours, each with probability one half."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Finite counterexample and confidence-set argument",
        "details": "The estimated rates are three and one, averaging two. The true rate is six divided by four, or 1.5 units per hour. The contrast variance equals output variance plus p squared times labour variance minus twice p times their covariance."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "The rate requires positive actual labour. The confidence set requires valid contrast intervals for the sampling design that produced both outcome estimates."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "The rate requires positive actual labour. The confidence set requires valid contrast intervals for the sampling design that produced both outcome estimates."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "Averaging reciprocals can give a different value from taking the reciprocal of an average. When H is positive, the contrast Q minus p times H equals zero at the true rate p. A set that includes every candidate whose valid contrast interval contains zero therefore covers the true rate at least as often as the interval for its contrast covers zero."
    backing [backing_material]
  }

  claim finding {
    statement "Dividing output by an unbiased labour estimate can yield a biased productivity rate. Confidence intervals for output minus rate times labour can identify a confidence set for the rate."
    environment engineering_work
  }

  claim exception_applies {
    statement "The proposed rate calculation divides by a zero or negative estimate of hours, or the procedure for the contrast fails its stated coverage conditions."
    environment engineering_work
  }

  // With zero or negative estimated hours, report the two component estimates.
  // A valid confidence set for the rate can have no finite upper bound.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}
