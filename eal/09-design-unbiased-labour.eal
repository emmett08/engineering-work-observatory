language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_09 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Proposition and proof",
        "details": "Let U be the finite set of eligible contributor intervals. Each interval has actual labour y, known positive inclusion probability pi, and an optional prediction f fixed before the draw. Every sampled labour allocation is measured accurately."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Proposition and proof",
        "details": "Adding the weighted residuals to all fixed predictions yields an expectation equal to the sum of actual labour. Setting all predictions to zero yields the Horvitz–Thompson estimator."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Unbiasedness concerns repeated draws from the stated frame with actual labour and predictions held fixed. It requires recorded inclusion probabilities reflecting the design and accurate sampled hours."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Unbiasedness concerns repeated draws from the stated frame with actual labour and predictions held fixed. It requires recorded inclusion probabilities reflecting the design and accurate sampled hours."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "The inclusion indicator I has expectation pi. Multiplying (y minus f) by I divided by pi thus yields expected contribution y minus f, even when interval selections are dependent."
    backing [backing_material]
  }

  claim finding {
    statement "Inverse-probability weighting estimates finite-frame labour without design bias, with or without fixed predictions."
    environment engineering_work
  }

  claim exception_applies {
    statement "The sampling excludes eligible work, uses incorrect selection chances, measures some selected intervals inaccurately or fits the predictions using the same correction sample."
    environment engineering_work
  }

  // Omitted contributors lie outside the frame. Incorrect weights, systematically
  // inaccurate replies, or fitting predictions to eliminate residuals on the correction
  // sample can also undermine the estimate.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}
