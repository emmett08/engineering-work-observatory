language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_13 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Forecast definition and synthetic replay",
        "details": "At task intake identify earlier tasks in the same prespecified class whose labour windows closed and whose measurements were already available. Include abandoned and unfinished tasks with measured hours."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Forecast definition and synthetic replay",
        "details": "In a synthetic team, five tasks provided initial history for eight later intakes. A class mean requiring two measurements forecast seven tasks, versus eight for the pooled mean. On the seven common tasks their mean absolute errors were 1.19 and 2.48 person-hours respectively. The eight evaluation tasks had true hours (2, 9, 12, 2, 6, 9, 6, 9) in intake order. Their class forecasts were (3, 9, unavailable, 2, 2, 9, 8/3, 9); the pooled forecasts were (6, 6, 13/3, 5, 47/8, 49/9, 11/2, 64/11). The third task was a migration with no prior example."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Prespecify the history window, classes, minimum measurements and comparable fallback. Use consistent labour accounting, and report coverage of eligible intakes and errors on common tasks."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Prespecify the history window, classes, minimum measurements and comparable fallback. Use consistent labour accounting, and report coverage of eligible intakes and errors on common tasks."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "A historical class mean estimates average incoming labour when the eligible history represents incoming tasks in that class. The time cutoff prevents future measurements leaking into the forecast."
    backing [backing_material]
  }

  claim finding {
    statement "The mean measured labour of earlier comparable tasks provides a transparent reference forecast at intake."
    environment engineering_work
  }

  claim exception_applies {
    statement "The history is too short or a change in repair effort, tools or timekeeping makes the recorded hours unrepresentative of incoming work."
    environment engineering_work
  }

  // Two late fixes in that synthetic team took six hours each, against class forecasts of
  // two and eight thirds hours. Changes in workload or measurement can break
  // comparability. Identify missing measurements, explain adjustments and withhold the
  // forecast when both class and fallback lack enough history.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}
