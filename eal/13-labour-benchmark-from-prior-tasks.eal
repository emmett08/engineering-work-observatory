language "EAL/4"

environment engineering_work {
  require true == true
}

module arg_13 {
  evidence grounds {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "grounds",
        "classification": "Forecast definition and worked intake sequence",
        "details": "At intake, select earlier tasks from the prespecified class. Their labour windows must have closed and their measurements must be available. Include measured hours from abandoned and unfinished tasks."
      }
    }
    require role == "grounds"
  }

  evidence backing_material {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "backing",
        "classification": "Forecast definition and worked intake sequence",
        "details": "The worked sequence starts with measurements for five tasks and evaluates eight later intakes. A class mean requiring two measurements forecast seven tasks. The pooled mean forecast all eight. Their mean absolute errors on the seven common tasks were 1.19 and 2.48 person-hours respectively. The evaluation tasks took (2, 9, 12, 2, 6, 9, 6, 9) hours in intake order. The class forecasts were (3, 9, unavailable, 2, 2, 9, 8/3, 9). The pooled forecasts were (6, 6, 13/3, 5, 47/8, 49/9, 11/2, 64/11). The third task was the first migration."
      }
    }
    require role == "backing"
  }

  evidence scope_conditions {
    kind argument_material
    environment engineering_work
    max_age 315360000
    derive material
    input {
      "material": {
        "role": "scope",
        "classification": "Conditions for applying this inference",
        "details": "Before evaluation, set the lookback period, define the task classes and specify how many earlier measurements each class needs. Define any fallback class using comparable tasks. Apply the same labour accounting throughout. Report the share of eligible intakes that received forecasts and compare errors on tasks both methods forecast."
      }
    }
    require role == "scope"
  }

  assumption applicability {
    statement "Before evaluation, set the lookback period, define the task classes and specify how many earlier measurements each class needs. Define any fallback class using comparable tasks. Apply the same labour accounting throughout. Report the share of eligible intakes that received forecasts and compare errors on tasks both methods forecast."
    environment engineering_work
    validate scope_conditions
  }

  reasoning warrant {
    method "structured/1"
    rationale "The class mean estimates average incoming labour when eligible earlier tasks represent the work arriving in that class. Use only measurements available at intake."
    backing [backing_material]
  }

  claim finding {
    statement "The mean measured labour of earlier comparable tasks provides a transparent reference forecast at intake."
    environment engineering_work
  }

  claim exception_applies {
    statement "The benchmark loses its basis if too few comparable measurements are available or if changes in workload or measurement make earlier tasks unrepresentative."
    environment engineering_work
  }

  // Two later fixes each took six hours. The class forecasts for those tasks were two
  // and eight thirds hours. Identify unmeasured hours and justify adjustments.
  // Withhold the forecast if the class and fallback both lack enough measurements.
  objection challenge = [premises exception_applies] -x> argument inference

  argument inference = [
    evidence grounds,
    assumptions applicability
  ] via warrant => finding
}
