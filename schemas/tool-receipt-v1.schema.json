{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "invocation_id",
    "phase",
    "timestamp",
    "platform",
    "declared",
    "tool",
    "result",
    "artifacts",
    "missing_fields"
  ],
  "properties": {
    "schema": {
      "const": "observatory.tool-receipt/1"
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "phase": {
      "enum": [
        "start",
        "completion"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "job_context_source",
        "repository_id",
        "repository",
        "workflow_ref",
        "workflow_sha",
        "run_id",
        "run_attempt",
        "job_key",
        "job_name",
        "job_id",
        "matrix",
        "actor",
        "triggering_actor",
        "event_name"
      ],
      "properties": {
        "source": {
          "const": "runner_environment"
        },
        "job_context_source": {
          "const": "caller"
        },
        "repository_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(unknown|[1-9][0-9]*)$"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "workflow_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "workflow_sha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(unknown|[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(unknown|[1-9][0-9]*)$"
        },
        "run_attempt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "job_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "job_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[1-9][0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "matrix": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 512
          }
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "triggering_actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "event_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      }
    },
    "declared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "controller",
        "controller_provenance",
        "protocol_id",
        "task_id",
        "session_id",
        "logical_call_id",
        "parent_invocation_id"
      ],
      "properties": {
        "source": {
          "const": "caller"
        },
        "controller": {
          "enum": [
            "human",
            "assistant",
            "automation",
            "unknown"
          ]
        },
        "controller_provenance": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          }
        },
        "protocol_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_call_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_invocation_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "name",
        "version",
        "purpose",
        "configured_model",
        "configuration"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "command",
            "codex_exec"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "enum": [
            "development",
            "product_execution",
            "unknown"
          ]
        },
        "configured_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasoning_effort",
            "temperature",
            "seed",
            "max_output_tokens",
            "configuration_sha256"
          ],
          "properties": {
            "reasoning_effort": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "temperature": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "seed": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                {
                  "type": "null"
                }
              ]
            },
            "configuration_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/result"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "name",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "role": {
            "enum": [
              "input",
              "output"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
            "allOf": [
              {
                "not": {
                  "enum": [
                    ".",
                    ".."
                  ]
                }
              },
              {
                "pattern": "^[^/\\\\]+$"
              }
            ]
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[a-z][a-z0-9_.]*$"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "start"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "$ref": "#/$defs/result"
          }
        }
      }
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exit_code",
        "runtime_ms",
        "observed_model",
        "observed_session_id",
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "charge_amount",
        "charge_currency",
        "usage_source",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "success",
            "failure",
            "cancelled",
            "unknown"
          ]
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_session_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "cached_input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "charge_amount": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "charge_currency": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 3,
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_source": {
          "enum": [
            "tool_reported",
            "unknown"
          ]
        },
        "checks": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "skipped",
                  "unknown"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "success"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "enum": [
                  null,
                  0
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failure"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "not": {
                  "const": 0
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "charge_amount": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "charge_currency": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "charge_currency": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "usage_source": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "observed_model": {
                "type": "null"
              },
              "observed_session_id": {
                "type": "null"
              },
              "input_tokens": {
                "type": "null"
              },
              "output_tokens": {
                "type": "null"
              },
              "cached_input_tokens": {
                "type": "null"
              },
              "charge_amount": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emmett08/engineering-work-observatory/schemas/tool-receipt-v1.schema.json",
  "title": "Observatory tool execution receipt v1",
  "description": "Immutable runner receipt. Declared provenance is not authenticated by schema or hash validation. A start and completion must retain the same invocation identity, platform, declared and tool values."
}
