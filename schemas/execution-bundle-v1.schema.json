{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "platform",
    "receipts"
  ],
  "properties": {
    "schema": {
      "const": "observatory.execution-bundle/1"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "job_context_source",
        "repository_id",
        "repository",
        "workflow_ref",
        "workflow_sha",
        "run_id",
        "run_attempt",
        "job_key",
        "job_name",
        "job_id",
        "matrix",
        "actor",
        "triggering_actor",
        "event_name"
      ],
      "properties": {
        "source": {
          "const": "runner_environment"
        },
        "job_context_source": {
          "const": "caller"
        },
        "repository_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(unknown|[1-9][0-9]*)$"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "workflow_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "workflow_sha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(unknown|[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(unknown|[1-9][0-9]*)$"
        },
        "run_attempt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "job_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "job_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[1-9][0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "matrix": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 512
          }
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "triggering_actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "event_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      }
    },
    "receipts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "receipt_json"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "receipt_json": {
            "type": "string",
            "minLength": 1,
            "maxLength": 262144
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emmett08/engineering-work-observatory/schemas/execution-bundle-v1.schema.json",
  "title": "Observatory execution evidence bundle v1",
  "description": "Each sha256 checks the integrity of the exact UTF-8 bytes of receipt_json; it does not authenticate the uploader or provenance. Parse each receipt_json with tool-receipt-v1.schema.json after checking its digest. Total UTF-8 bundle size is bounded at 16 MiB."
}
