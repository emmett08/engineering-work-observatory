{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emmett08/engineering-work-observatory/schemas/observation-config-v1.schema.json",
  "title": "Public observation collection configuration v1",
  "description": "Public repositories are verified before issue acquisition. Import open and closed issues; max_pages is a bound, never a completeness claim. Repository/task aliases must additionally be unique and all tasks must be in configured sources.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "protocol_id", "sources", "task_links"],
  "properties": {
    "schema": {"const": "observatory.observation-config/1"},
    "protocol_id": {"$ref": "effort-observation-v1.schema.json#/$defs/identifier"},
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository", "issue_numbers", "title_prefix", "max_pages"],
        "properties": {
          "repository": {"$ref": "effort-observation-v1.schema.json#/$defs/repository"},
          "issue_numbers": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "effort-observation-v1.schema.json#/$defs/number"}},
          "title_prefix": {"$ref": "effort-observation-v1.schema.json#/$defs/identifier"},
          "max_pages": {"type": "integer", "minimum": 1, "maximum": 100}
        }
      }
    },
    "task_links": {"type": "array", "maxItems": 1000, "items": {"$ref": "effort-observation-v1.schema.json#/$defs/task"}}
  }
}
