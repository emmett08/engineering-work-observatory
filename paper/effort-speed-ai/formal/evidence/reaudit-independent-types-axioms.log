EffortSpeed.covariance_counterexample :
  EffortSpeed.var4 EffortSpeed.score4 = 1 ∧
    EffortSpeed.var4 EffortSpeed.duration4 = 25 ∧
      EffortSpeed.cov4 EffortSpeed.score4 EffortSpeed.duration4 = 4 ∧
        EffortSpeed.var4 EffortSpeed.efficiency4 = 18 ∧
          EffortSpeed.cov4 EffortSpeed.score4 EffortSpeed.duration4 ^ 2 /
                (EffortSpeed.var4 EffortSpeed.score4 * EffortSpeed.var4 EffortSpeed.duration4) =
              16 / 25 ∧
            EffortSpeed.var4 EffortSpeed.efficiency4 / EffortSpeed.var4 EffortSpeed.duration4 >
              1 -
                EffortSpeed.cov4 EffortSpeed.score4 EffortSpeed.duration4 ^ 2 /
                  (EffortSpeed.var4 EffortSpeed.score4 * EffortSpeed.var4 EffortSpeed.duration4)
